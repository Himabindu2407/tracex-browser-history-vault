{
  "manifest_version": 3,
  "name": "TraceX - Browser History Vault",
  "version": "1.3.0",
  "description": "A local-first browsing history vault with user-controlled tracking and automatic two-calendar-month retention.",
  "permissions": [
    "history",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "db.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "TraceX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "dashboard/dashboard.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a01d9174-8ce7-43c6-9618-dc82523c9fed}",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
